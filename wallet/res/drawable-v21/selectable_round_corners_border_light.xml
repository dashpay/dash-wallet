<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_ripple_light">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <!--
              Must stay theme-aware despite this drawable's "_light" name: it is the
              background of the expanded contested-name rows on Username Voting, whose
              text uses theme-aware styles (@style/Overline). A hardcoded white here
              left those rows white with invisible white-on-white text in dark mode.
              background_secondary IS #FFFFFF (palette_white) by day, so this is
              pixel-identical in light mode, and palette_black_800 at night.
            -->
            <solid android:color="@color/background_secondary" />
            <stroke android:color="@color/button_ripple_light" android:width="1dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@android:color/holo_red_dark" />
        </shape>
    </item>
</ripple>
