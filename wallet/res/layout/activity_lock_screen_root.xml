<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_deep_blue"
    android:fitsSystemWindows="true">

    <!-- single inset point: root stays false so the background paints
         edge-to-edge, while all switcher content avoids the system bars -->
    <ViewAnimator
        android:id="@+id/root_view_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:ignore="UselessParent">

        <include
            android:id="@+id/lock_screen"
            layout="@layout/activity_lock_screen" />

        <!-- insets are consumed by the root; do not re-apply fitsSystemWindows here -->
        <FrameLayout
            android:id="@+id/regular_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </ViewAnimator>
</FrameLayout>