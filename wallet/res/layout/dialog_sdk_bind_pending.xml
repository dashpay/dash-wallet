<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/drag_indicator"
        android:layout_width="35dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginVertical="7dp"
        android:background="@drawable/rounded_background"
        android:theme="@style/DragIndicatorBackground"
        tools:background="@color/light_gray" />

    <TextView
        android:id="@+id/title"
        style="@style/Headline5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_horizontal"
        android:textAlignment="gravity"
        tools:text="@string/sdk_bind_pending_finishing_title" />

    <TextView
        android:id="@+id/message"
        style="@style/Body2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_horizontal"
        android:textAlignment="gravity"
        tools:text="@string/sdk_bind_pending_finishing_message" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:indeterminate="true" />

    <Button
        android:id="@+id/retry_button"
        style="@style/Button.Primary.Large.Blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="15dp"
        android:text="@string/sdk_bind_pending_retry" />

    <Button
        android:id="@+id/close_button"
        style="@style/Button.Tertiary.Large.Blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="15dp"
        android:text="@string/button_close" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="15dp" />
</LinearLayout>
