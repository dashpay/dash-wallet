<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_maya"
    app:startDestination="@id/mayaPortalFragment">
    <fragment
        android:id="@+id/mayaPortalFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaPortalFragment"
        android:label="mayaPortalFragment">
        <action android:id="@+id/mayaPortal_to_currencyPicker"
            app:destination="@id/mayaCurrencyPickerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left"/>
    </fragment>

    <fragment
        android:id="@+id/mayaCurrencyPickerFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaCryptoCurrencyPickerFragment"
        android:label="mayaPortalFragment" >
        <action android:id="@+id/mayaCurrencyPicker_to_addressInput"
            app:destination="@id/mayaAddressInputFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left"/>

        <action android:id="@+id/mayaCurrencyPicker_to_dexEnterAmount"
            app:destination="@id/dexEnterAmountFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left"/>

    </fragment>

    <fragment
        android:id="@+id/dexEnterAmountFragment"
        android:name="org.dash.wallet.integrations.maya.ui.DEXEnterAmountFragment"
        android:label="dexEnterAmountFragment">
        <argument
            android:name="asset"
            app:argType="string" />
        <argument
            android:name="currency"
            app:argType="string" />
        <argument
            android:name="fiatCurrency"
            app:argType="string"
            android:defaultValue="USD" />

        <action android:id="@+id/dexEnterAmount_to_dexRefundAddress"
            app:destination="@id/dexRefundAddressFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left"/>
    </fragment>

    <fragment
        android:id="@+id/dexRefundAddressFragment"
        android:name="org.dash.wallet.integrations.maya.ui.DEXRefundAddressFragment"
        android:label="dexRefundAddressFragment">
        <argument
            android:name="asset"
            app:argType="string" />
        <argument
            android:name="currency"
            app:argType="string" />

        <action android:id="@+id/dexRefundAddress_to_dexReceive"
            app:destination="@id/dexReceiveFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left"/>
    </fragment>

    <fragment
        android:id="@+id/dexReceiveFragment"
        android:name="org.dash.wallet.integrations.maya.ui.DEXReceiveFragment"
        android:label="dexReceiveFragment">
        <argument
            android:name="asset"
            app:argType="string" />
        <argument
            android:name="currency"
            app:argType="string" />
        <!-- Human-unit amount of the crypto being sent in; used to build the deposit payment URI. -->
        <argument
            android:name="sellAmount"
            app:argType="string" />
        <!-- SwapKit inbound deposit address, resolved by the refund screen's createBuyOrder call. -->
        <argument
            android:name="depositAddress"
            app:argType="string" />
        <!-- Chain memo/tag some chains require alongside the deposit; empty when none. A deposit
             sent without a required memo can't be attributed to the swap (funds lost), so the
             receive screen must display it. -->
        <argument
            android:name="memo"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/mayaAddressInputFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaAddressInputFragment"
        android:label="Address Input" >
        <argument
            android:name="currency"
            app:argType="string" />
        <argument
            android:name="asset"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />

        <argument
            android:name="hint"
            app:argType="string"
            />

        <action android:id="@+id/mayaAddressInput_to_EnterAmount"
            app:destination="@id/mayaConvertCryptoFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment android:id="@+id/mayaConvertCryptoFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaConvertCryptoFragment"
        android:label="Enter Amount">

        <argument android:name="currency"
            app:argType="string" />
        <argument android:name="asset" app:argType="string" />
        <argument android:name="paymentIntent"
            app:argType="org.dash.wallet.common.data.PaymentIntent" />

        <action
            android:id="@+id/mayaConvertCryptoFragmentToMayaConversionPreviewFragment"
            app:destination="@id/mayaConversionPreviewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <dialog
        android:id="@+id/mayaFeeInfoDialog"
        android:name="org.dash.wallet.integrations.maya.ui.dialogs.MayaFeeInfoDialog"
        android:label="maya_info_fee"
        tools:layout="@layout/dialog_maya_fee_info"
        />
    <fragment
        android:id="@+id/mayaConversionPreviewFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaConversionPreviewFragment"
        android:label="MayaConversionPreviewFragment">

        <action
            android:id="@+id/mayaOrderReviewToFeeInfo"
            app:destination="@id/mayaFeeInfoDialog" />
        <action android:id="@+id/mayaOrderPreviewToOrderExecution"
            app:destination="@+id/mayaConvertResultFragment"
            app:enterAnim="@anim/slide_in_right"
            app:popEnterAnim="@anim/activity_stay"
            app:exitAnim="@anim/activity_stay"
            app:popExitAnim="@anim/slide_out_left" />
        <argument
            android:name="swapModel"
            app:argType="org.dash.wallet.integrations.maya.model.SwapTradeUIModel" />
        <argument android:name="currency"
            app:argType="string" />
        <argument android:name="paymentIntent"
            app:argType="org.dash.wallet.common.data.PaymentIntent" />
    </fragment>

    <fragment
        android:id="@+id/mayaConvertResultFragment"
        android:name="org.dash.wallet.integrations.maya.ui.MayaConvertResultFragment"
        android:label="MayaConvertResultFragment">
        <argument
            android:name="transactionParams"
            app:argType="org.dash.wallet.integrations.maya.ui.convert_currency.model.MayaTransactionParams"
            />

    </fragment>
</navigation>